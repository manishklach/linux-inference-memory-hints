From: Research Team <research@example.local>
Date: Sun, 3 May 2026 12:10:00 -0700
Subject: [PATCH 0002/0003] RFC: mm: accept semantic madvise hints

// SPDX-License-Identifier: GPL-2.0-only
/* RFC ONLY – NOT FOR SUBMISSION */

This patch allows the kernel to recognize and accept the new
MADV_SEMANTIC_* hints. At this stage, the hints are validated for
address range and permission but do not trigger any underlying
memory policy or metadata tracking.

The goal is to provide a clean detection point for userspace
research tools.

Signed-off-by: Research Team <research@example.local>
---
 mm/madvise.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/mm/madvise.c b/mm/madvise.c
index a828f80..b938c90 100644
--- a/mm/madvise.c
+++ b/mm/madvise.c
@@ -1094,6 +1094,11 @@ static int madvise_vma_behavior(struct vm_area_struct *vma,
 		break;
 	case MADV_COLLAPSE:
 		return madvise_collapse(vma, prev, start, end);
+	case MADV_SEMANTIC_STREAMING:
+	case MADV_SEMANTIC_REUSE:
+	case MADV_SEMANTIC_EPHEMERAL:
+		/* RFC: Logic/Policy deferred to Milestone 3 */
+		return 0;
 	}
 
 	anon_name = anon_vma_name(vma);
@@ -1198,6 +1203,10 @@ madvise_behavior_valid(int behavior)
 	case MADV_HWPOISON:
 #endif
+	case MADV_SEMANTIC_STREAMING:
+	case MADV_SEMANTIC_REUSE:
+	case MADV_SEMANTIC_EPHEMERAL:
 		return true;
 
 	default:
-- 
