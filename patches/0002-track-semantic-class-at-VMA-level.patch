From: Research Team <research@example.local>
Date: Sun, 3 May 2026 11:10:00 -0700
Subject: [PATCH 2/3] RFC (DO NOT SUBMIT): mm: implement semantic state storage via vm_private_data

// SPDX-License-Identifier: GPL-2.0-only
/* RFC ONLY – NOT FOR SUBMISSION */

Store the semantic class in a dynamically allocated struct attached
to vma->vm_private_data. This avoids conflicts with core VM flags
and provides a safe container for future extensions.

Implementation Notes:
- Only applied to anonymous VMAs for v1 prototype.
- Uses kzalloc/kfree for lifecycle management.
- Note: VMA splitting/merging behavior is not fully handled in this
  prototype and may result in lost hints or minor leaks.

Signed-off-by: Research Team <research@example.local>
---
 mm/madvise.c | 55 ++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 55 insertions(+)

diff --git a/mm/madvise.c b/mm/madvise.c
index 4b0746e5a..f8a7e0d3c 100644
--- a/mm/madvise.c
+++ b/mm/madvise.c
@@ -40,6 +40,16 @@ struct madvise_walk_private {
 	bool pageout;
 };
 
+/* RFC ONLY – NOT FOR SUBMISSION */
+enum semantic_class {
+	SEMANTIC_NONE = 0,
+	SEMANTIC_STREAMING,
+	SEMANTIC_REUSE,
+	SEMANTIC_EPHEMERAL,
+};
+
+struct vm_semantic_info {
+	u8 semantic_class;
+};
+
 /*
  * Check if the madvise behavior is valid for the given VMA.
  */
@@ -95,6 +105,43 @@ static int madvise_vma_behavior(struct vm_area_struct *vma,
 	unsigned long new_flags = vma->vm_flags;
 	int error = 0;
 
+	/* Handle Semantic Hints - RFC ONLY */
+	if (behavior >= MADV_SEMANTIC_STREAMING && behavior <= MADV_SEMANTIC_EPHEMERAL) {
+		struct vm_semantic_info *info;
+
+		/* For v1, only support anonymous memory */
+		if (vma->vm_file)
+			return -EINVAL;
+
+		info = vma->vm_private_data;
+		if (!info) {
+			info = kzalloc(sizeof(*info), GFP_KERNEL);
+			if (!info)
+				return -ENOMEM;
+			vma->vm_private_data = info;
+		}
+
+		switch (behavior) {
+		case MADV_SEMANTIC_STREAMING:
+			info->semantic_class = SEMANTIC_STREAMING;
+			break;
+		case MADV_SEMANTIC_REUSE:
+			info->semantic_class = SEMANTIC_REUSE;
+			break;
+		case MADV_SEMANTIC_EPHEMERAL:
+			info->semantic_class = SEMANTIC_EPHEMERAL;
+			break;
+		}
+		return 0;
+	}
+
 	switch (behavior) {
 	case MADV_REMOVE:
 		return madvise_remove(vma, prev, start, end);
-- 
