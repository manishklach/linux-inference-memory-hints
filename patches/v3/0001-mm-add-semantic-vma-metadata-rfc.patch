From: Research Team <research@example.local>
Date: Sun, 3 May 2026 13:00:00 -0700
Subject: [PATCH 0001/0003] RFC: mm: add semantic hint metadata to struct vm_area_struct

// SPDX-License-Identifier: GPL-2.0-only
/* RFC ONLY – NOT FOR SUBMISSION */

This patch adds a new field 'vm_semantic_hint' to struct vm_area_struct
to persistently track userspace memory intent. This allows the kernel
to preserve semantic information (streaming, reuse, ephemeral) across
the lifetime of the VMA.

By placing this field in vm_area_struct, we ensure that semantic hints
are automatically preserved during VMA splitting and basic lifecycle
transitions.

Signed-off-by: Research Team <research@example.local>
---
 include/linux/mm.h       | 7 +++++++
 include/linux/mm_types.h | 3 +++
 2 files changed, 10 insertions(+)

diff --git a/include/linux/mm.h b/include/linux/mm.h
index 123456789abc..8d28f802e2c1 100644
--- a/include/linux/mm.h
+++ b/include/linux/mm.h
@@ -265,6 +265,13 @@ extern unsigned int kobj_max_free_obj(struct kobject *kobj);
 #define VM_HIGH_ARCH_BIT_BIT		34
 #endif /* CONFIG_ARCH_USES_HIGH_VMA_FLAGS */
 
+/* RFC: Semantic memory hints */
+#define VM_SEMANTIC_NONE	0
+#define VM_SEMANTIC_STREAMING	1
+#define VM_SEMANTIC_REUSE	2
+#define VM_SEMANTIC_EPHEMERAL	3
+/* End RFC */
+
 #ifndef VM_GROWSUP
 #define VM_GROWSUP	VM_NONE
 #endif
diff --git a/include/linux/mm_types.h b/include/linux/mm_types.h
index abc123456789..8d28a802e2d1 100644
--- a/include/linux/mm_types.h
+++ b/include/linux/mm_types.h
@@ -620,6 +620,9 @@ struct vm_area_struct {
 
 	struct vma_numab_state *numab_state;	/* NUMA balancing state */
 #endif
+#ifdef CONFIG_MM_SEMANTIC_HINTS /* RFC placeholder */
+	u8 vm_semantic_hint;
+#endif
+	u8 vm_semantic_hint; /* Force for RFC prototype */
 } __randomize_layout;
 
 struct vma_lock {
