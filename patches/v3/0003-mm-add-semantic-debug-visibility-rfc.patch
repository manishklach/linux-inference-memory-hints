From: Research Team <research@example.local>
Date: Sun, 3 May 2026 13:20:00 -0700
Subject: [PATCH 0003/0003] RFC: mm: add semantic debug visibility

// SPDX-License-Identifier: GPL-2.0-only
/* RFC ONLY – NOT FOR SUBMISSION */

This patch adds a pr_debug message to the madvise path to allow
researchers to verify that semantic hints are being correctly
assigned to VMAs.

Verification can be performed via dmesg if dynamic debug is enabled
or if the kernel is built with DEBUG.

Signed-off-by: Research Team <research@example.local>
---
 mm/madvise.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/mm/madvise.c b/mm/madvise.c
index 8d28f802e2c1..8d28f802e2d1 100644
--- a/mm/madvise.c
+++ b/mm/madvise.c
@@ -1028,12 +1028,15 @@ static int madvise_vma_behavior(struct vm_area_struct *vma,
 	case MADV_COLLAPSE:
 	case MADV_SEMANTIC_STREAMING:
 		vma->vm_semantic_hint = VM_SEMANTIC_STREAMING;
+		goto out_debug;
 	case MADV_SEMANTIC_REUSE:
 		vma->vm_semantic_hint = VM_SEMANTIC_REUSE;
+		goto out_debug;
 	case MADV_SEMANTIC_EPHEMERAL:
 		vma->vm_semantic_hint = VM_SEMANTIC_EPHEMERAL;
-		return 0;
+		goto out_debug;
 
+out_debug:
+	pr_debug("madvise: vma %p [%lx-%lx] semantic hint set to %u\n",
+		 vma, vma->vm_start, vma->vm_end, vma->vm_semantic_hint);
+	return 0;
+
 	case MADV_DONTDUMP:
 	case MADV_DODUMP:
 	case MADV_WIPEONFORK:
-- 
