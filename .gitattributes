# Language detection overrides - Force C detection
*.c linguist-language=C
*.h linguist-language=C
*.patch linguist-language=C

# Vendor/Ignore scripts and docs to prevent them from dominating language stats
scripts/** linguist-vendored
tools/** linguist-vendored
docs/** linguist-documentation
benchmarks/** linguist-detectable=true

# Ignore generated build artifacts
kernel-build/** linguist-vendored
rootfs.ext4 linguist-vendored
bzImage linguist-vendored
